# Production uchun barchasini hosting platformasidagi Environment Variables bo'limida sozlang.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=your-domain.uz,.up.railway.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.uz,https://your-app.up.railway.app
# PostgreSQL hosting platformasi DATABASE_URL beradi
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# SMS reminders (Twilio). SMS yuborish uchun telefon raqam xalqaro formatda saqlansin.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
